# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。
#
#   cp .env.example .env && vim .env
#   set -a && source .env && set +a
#   python3 cli.py doctor
#
# 监控面板（cli.py serve）的变量在文件靠后的「监控面板」一节，见 docs/面板.md。

# ---------- 数据通道（双通道，两个都填就自动降级） ----------
# 默认两个平台都优先 TikHub，SocialDataX 兜底。
# 只填一个也能跑：没配 Key 的那家会自动从顺序里滤掉。
# 完整对比见 docs/供应商对比.md。

# TikHub：抖音便宜 93%，小红书便宜 28%。
# 申请/管理：https://user.tikhub.io
TIKHUB_API_KEY=

# TikHub 的接入域名，**按服务器在哪选**（对方要求「请勿跨区使用」）：
#   不填          → api.tikhub.dev，境内境外都通，适合国内 VPS
#   境外服务器     → https://api.tikhub.io（Railway、GitHub Actions 用这个）
# TIKHUB_BASE=https://api.tikhub.io

# SocialDataX：单价高，但错误码是有契约的（1006 封控 / 1008 已删除），
# 判失效比 TikHub 准。留着当备胎，平时不花钱。
# 申请/管理：https://socialdatax.com
SOCIALDATAX_API_KEY=

# ---------- 飞书自建应用 ----------
# 开放平台建企业自建应用 → 开权限 bitable:app → 发布版本
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# —— 只巡查一张表 ——
# 多维表格地址 https://xxx.feishu.cn/base/<app_token>?table=<table_id>
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# —— 巡查多张表（设了它就以它为准，上面两个忽略；也可以只放一张表，
#     直接用这一个变量代替上面两个）——
# 分号分隔，每一项：标签=app_token:table_id 或 标签=表格完整网址。
# 表格完整网址两种都认：/base/xxx?table=tblxxx（普通多维表格）、
# /wiki/xxx?table=tblxxx（挂在知识库里的表——地址栏那段 token 直接当
# app_token 用，接口照样认，不用额外换算、不用多开权限）。
# 标签用在日志分节和 --table 筛选上，起个人能认的名字。
# 所有表共用同一个飞书应用，但应用要**逐张表**「添加文档应用」授权。
# 值要加引号：里面有分号和空格，「set -a && source .env」不加引号会被 shell 拆开。
# FEISHU_TABLES="OKMAN一期=bascnXXX:tblAAA; OKMAN二期=https://xx.feishu.cn/base/bascnXXX?table=tblBBB; 客户C=bascnYYY:tblCCC"

# ---------- 可选调参 ----------
# 并发上限。官方 skill 要求最多 3，默认取 2 留一档余量。
# 合法区间 1–3，越界会**拒绝启动**（不是静默改成合法值）。
MAX_CONCURRENCY=2

# 小红书笔记发布多少天内额外调一次 detail。默认 0 = 不调。
# 它原本只为「点赞数/收藏数」两列服务，那四列已经去掉了，所以这笔钱
# （约占月成本 39%）没有理由再花。关掉后小红书失去 in_censor 审核标记，
# 且删帖判定从一轮变成两击（0-2 天档晚约 16 小时）；判定链路不受影响。
# 想要回来就填 7，或填 2 只保住风控/删帖最可能发生的头两天。
DETAIL_WITHIN_DAYS=0

# 单次运行的软截止（秒）。Railway 独立服务跑批量设 0（不限）；
# 只在受执行时限约束的运行时里才需要设一个正值。
# ⚠️ 有硬超时的运行时（GitHub Actions 30 分钟）**必须**设一个明显更小的值，
# 并给写回留出余量——被硬杀时，本轮已经付费、还没写回的结果会全部丢掉。
SOFT_DEADLINE_SECONDS=0

# 新入册的表首轮最多刷几行（0 = 不限，默认 20）。
# 整张表一个「最近检查时间」都没有 = 全新表，或者刚在面板上把那一列建出来。
# 两种情况下每一行都判到期，一轮就是全表付费。这个闸和下面的
# MAX_RECORDS_PER_RUN 不是一回事：那个是整次运行共享的，这个是**单张新表**的，
# 防的是「一张 800 行的表刚入册就吃掉整轮预算」。剩下的行每轮再来一批。
# FIRST_RUN_MAX_RECORDS=20

# ---------- 单轮硬预算（0 = 不限） ----------
# 三个闸门任一触顶就停止派发新行；已到手的结果照常写回，
# 没轮到的行保持原样（排队勾还在、最近检查时间没动），下一轮自然继续。
#
# 🚨 **MAX_YUAN_PER_RUN 应该当成必配项。** 它是三个里唯一的**硬**上限
# （另两个只是行数/请求数，见 config.Budget 的说明），也是下面这三类事故
# 唯一的共同兜底——它们的单轮成本都没有上界，而且**都不会报错**：
#   · 全表被误勾「排队刷新」
#   · 「最近检查时间」整列被清空 → 每一行都判到期
#   · 上游故障导致每轮熔断又每轮重刷（TikHub 对失败也计费）
# 按你们一轮的正常花费给 3–5 倍即可。没设的话 doctor 和每一轮开跑都会警告。
MAX_YUAN_PER_RUN=50
MAX_RECORDS_PER_RUN=300
# MAX_CALLS_PER_RUN=600

# ---------- 监控面板（python3 cli.py serve） ----------
# 面板是 Railway 上的**第二个 service**，常驻、只读、一个付费请求都不发。
# ⚠️ 它**绝不能**配 cron，也绝不能和 queue/sweep 配在同一个 Start Command 里：
# 两个容器同时刷同一张表 = 钱花两份 + 人工标签被旧快照覆盖 + 飞书写冲突，
# 而运行租约是文件锁，跨容器拦不住（见下一节）。

# 面板口令。**没设就拒绝启动**——这个服务会把所有项目的监控数据放到公网上，
# 不能默认裸奔。至少 12 个字符，公网上的短口令等于没有口令。
# PANEL_PASSWORD=

# ⚠️ 面板服务上**不要**配 TIKHUB_API_KEY / SOCIALDATAX_API_KEY。
# 它一个付费请求都不发，配上只是让公网那一侧多两份密钥。
# （日志里的 Key 由 cron 那边在打印之前就脱掉了，不依赖面板再脱一次。）
# 代价只有一个：面板报的「预计花费」会按配置的主通道计价，
# 而不是「第一家真配了 Key 的」——只配备胎 Key 时那个数会偏。

# 签会话 Cookie 用的密钥。不填就每次启动随机生成（重启即掉线，可以接受）。
# 刻意不给默认值：默认密钥会被抄进每一个部署，等于人人都能伪造会话。
# **填的话至少 32 个字符**，短于这个直接拒绝启动：猜中它就能自己签一个
# 未来过期的 Cookie 绕过 PANEL_PASSWORD，而伪造 Cookie 不走登录节流，
# 可以离线慢慢试。生成一个：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# PANEL_SECRET=

# 聚合结果缓存多少秒（5–3600，默认 60）。后台一个线程按这个节奏刷，
# 所有人看同一份快照——改成「每次开页面就拉一遍」，五个人同时刷新
# 就是五倍飞书请求，而每一趟要把每张表整表读回来。
# PANEL_CACHE_SECONDS=60

# 面板上要不要展示「评论区快照 / 负面评论快照」的正文。**默认 0（不展示）。**
# 那两列里有别人写的评论正文、昵称和 IP 属地，是个人信息；面板对运营开放、
# 又挂在公网上，默认展示等于把暴露面放大一圈。运营需要的「发生了什么、
# 去哪查」由机器写的「诊断信息」和直达链接满足，那一列不含个人信息。
# 你们法务过完再开。
# PANEL_SHOW_DIGEST=0

# —— 在面板上加表删表 ——
# 表清单存在一张飞书表里。为什么需要它：面板和 cron 是两个**不共享任何东西**
# 的容器（Volume 只能挂一个服务，cron 每 5 分钟起一次跑完就退），
# 「你在面板上点了加表」必须落到一个 cron 五分钟后读得到的地方。
#
# 跑一次 `python3 cli.py init-registry`，它自动建好并打印这一行让你粘，
# **这辈子只做一次**。之后加表删表全在面板上，你不用再打开那张表。
# ⚠️ cron 那个服务也要设同一个值，它才知道要刷哪些表。
# FEISHU_REGISTRY=

# 自动给**已有的**选择列补选项。**默认关，先在一张废表上验过再开。**
# 飞书的 PUT fields 对 property 是整体覆盖、按 id 认选项，写错一次就是
# 清空全表那一列的值且不可逆（「流量状态」是人机共用的多选列）。
# 代码是按安全写法写的（带 id 原样回填 + 硬断言只增不减），但那个写法本身
# 还没在真机上验过。验证步骤见 docs/面板.md「为什么补选项默认不代劳」。
# 建**新**列不受这个开关影响——那是纯追加，一直是自动的。
# PANEL_ALLOW_OPTION_PATCH=0

# 面板上一次最多勾多少行「排队刷新」（代码里写死 200，这里只是说明）。
# 面板不发付费请求——勾上之后由 cron 接手，和你在飞书里手工勾同一条路，
# 同样受下面 MAX_YUAN_PER_RUN / MAX_RECORDS_PER_RUN 约束。
# 已归档的老帖不在批量勾选范围里（「排队刷新」会绕过归档线）。

# —— Railway 日志（可选）——
# 设上之后，面板能显示「运行历史」（每一轮跑了什么、花了多少、有没有熔断），
# 和 Railway 上的原始日志尾巴。不设也能用，只是那一块是空的。
#
# ⚠️ 还要在 **cron 那个服务**上设 RUN_LOG_JSON=1，日志里才有结构化事件；
# 没有它面板只能看到人读的文本，解析不出运行历史。
#
# 🚨 **token 的选型是个安全决定，不只是配置。**
# 同一套 GraphQL 上有 `variables` 查询——一个能读日志的 **account /
# workspace token，同样能读回这个项目的全部环境变量**：TIKHUB_API_KEY、
# SOCIALDATAX_API_KEY、FEISHU_APP_SECRET 全在里面。用一把能解开所有密钥的
# 钥匙去换一段日志摘要，这笔交换不一定划算。
#
# 所以优先用 **project token**（范围限于一个项目的一个环境）：
# RAILWAY_PROJECT_TOKEN=
#
# project token 能不能读 environmentLogs 还没实测过。读不了才退回下面这个，
# 而且请建在**面板服务的服务级**变量里、不要建项目级（cron 那个服务不需要它）。
# 实在不放心就整块不配，面板其余部分照常工作。
# RAILWAY_API_TOKEN=
#
# RAILWAY_ENVIRONMENT_ID=
# 只看 cron 那个服务的日志（强烈建议：面板自己的访问日志混进来毫无价值，
# 还会把真正要看的巡检输出挤出翻页窗口）
# RAILWAY_CRON_SERVICE_ID=
#
# ⚠️ 日志保留期由 Railway 套餐决定：Hobby 7 天 / Pro 30 天。面板**不另存**，
# 所以「运行历史」最多往回看那么久。

# 飞书租户域名，用来拼「去这一行」的直达链接（面板的价值有一半在那个链接上）。
# 形如 https://xxx.feishu.cn，就是你打开多维表格时地址栏那一段。
# 不设的话会试着从 FEISHU_TABLES 里的完整网址扒一个；再不行退回通用域名，
# 那时链接不一定跳得准，面板上会提示。
# FEISHU_DOMAIN=

# ---------- 运行租约（防止两个进程同时刷同一张表） ----------
# 默认开启，锁文件在 $TMPDIR/linkcheck-<你的 uid>/run.lock（每个用户一个
# 私有目录，权限 0700）——刻意不用 /tmp 里一个所有人都能预测的固定文件名：
# 共享主机上别人可以抢先把它建成符号链接，而我们会 ftruncate + 写它。
# 拿不到锁的进程直接退出，一个付费请求都不发。
# ⚠️ 这是**文件锁**，只在同一台机器/同一个文件系统上生效；跨主机
# （Railway 两个 service、Railway + Actions）挡不住，那要靠部署纪律：
# 定时调度只能有一个地方跑，见 docs/部署.md。
# RUN_LOCK_PATH=/var/lib/xhsearch/run.lock
# RUN_LOCK_DISABLED=0

# ---------- 可观测性 ----------
# 设 1 时每行结果额外输出一条 JSON 到 stderr（run_id/table/status/cost…），
# 方便按 run 聚合、接指标后端和告警。控制台文本照常输出，给人看。
# RUN_LOG_JSON=0

# 日志里的时间按哪个时区打印（小时偏移，支持 5.5 这样的半小时）。
# 默认 +8 = 北京时间，和飞书国内租户渲染「最近检查时间」的口径一致——
# 容器日志行首的时间戳是 UTC，不对齐的话两边差 8 小时，谁看都觉得对不上。
# ⚠️ 只影响**打印**：写进表里的永远是 UTC 时间戳，改这个不会改任何数据。
# DISPLAY_UTC_OFFSET=8

# ---------- 评论区快照的数据最小化 ----------
# 「评论区快照」列会长期保存**别人写的评论正文、昵称和 IP 属地**。
# 这些是个人信息：保留期、访问范围和跨境传输建议先过一遍法务/信息安全。
# 下面两个开关不改代码就能收窄落库范围（默认都写，保持原行为）。
# DIGEST_SHOW_AUTHOR_NAME=1
# DIGEST_SHOW_IP_LOCATION=1

# ---------- 最低热度档「观察中」 ----------
# 发布不满 48 小时（Thresholds.flop_hours）且评论数不足 20 的行打这个标签。
# 它存在的唯一理由是**不留空格**：在它之前这些行一个标签都不打，
# `流量状态` 那一格是空的，而空格分不出「还没轮到它 / 轮到了没结论 / 机器坏了」，
# 于是新发的一批帖子只能一条条手工填。到 48 小时它会自动升成「无水花」。
# 改名要同时去飞书把多选选项建好；留空 = 关掉这一档，行为退回从前。
# 改名和关掉都会把**旧名字**退役掉，已经写出去的「观察中」下一轮自动摘掉——
# 不这么做的话旧值会掉到机器命名空间外面、被当成人工标签保护起来，
# 于是一行同时挂着两个热度档。
# ⚠️ 发布时间填成未来的行**不打**这一档：负的时长同样「不足 48 小时」，
# 打上去会让一个看着合理的标签把日期错误盖住，改成在「诊断信息」里报出来。
# TAG_OBSERVING=观察中

# ---------- 计价覆盖（供应商改价时用，不用改代码） ----------
# 代码里的默认单价核对于 providers.PRICING_CHECKED_ON 那一天。
# USD_TO_CNY=7.2
# TIKHUB_USD_XHS=0.010
# TIKHUB_USD_DOUYIN=0.001
# SOCIALDATAX_YUAN=0.10

# ---------- 端点覆盖（危险，默认别开） ----------
# TIKHUB_BASE 只允许 https:// 且主机在白名单里（api.tikhub.io / api.tikhub.dev）。
# 改 base 等于改「API Key 发到哪台机器」。确实要指向自建代理才开这个。
# ALLOW_UNSAFE_ENDPOINT_OVERRIDE=0

# 通道顺序。不填就用默认（两个平台都是 tikhub 优先、socialdatax 兜底）。
# 想把某个平台钉死在一家时用，格式：平台=第一家,第二家；平台=……
# CHANNEL_ORDER=xhs=socialdatax; douyin=tikhub
